# ==============================================================================
# EduNotes — Template Environment Variables
# Salin file ini menjadi .env di root project untuk pengembangan lokal di VSCode.
# Untuk deployment Netlify, masukkan variabel ini di:
# Netlify Dashboard -> Site configuration -> Environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRET (WAJIB untuk Analisis AI Sungguhan)
# Variabel ini HANYA dibaca oleh server (server.ts / Netlify Functions).
# JANGAN gunakan prefix VITE_ demi keamanan agar tidak bocor ke browser!
# Link resmi: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD DATABASE (WAJIB untuk Penyimpanan Data Bersama / Multi-User)
# Seluruh buku, bab, subbab, versi, dan riwayat scan disimpan di Supabase Cloud.
# Dapatkan kredensial di: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
